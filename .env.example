# Copy to .env on the host. Do not commit .env. None of these values are set in git.

# Primary transactional database. Neon and Aurora both hand you a postgres URL.
# Leave unset and this machine uses SQLite at data/zendo.sqlite.
ZENDO_DATABASE_URL=

# Local Docker Compose only. Keep these values in an untracked .env file.
# ZENDO_DATABASE_URL must point to the Compose `postgres` service from the
# `zendo` container, or to the intended hosted PostgreSQL service.
ZENDO_POSTGRES_USER=
ZENDO_POSTGRES_PASSWORD=
ZENDO_POSTGRES_DB=

# Optional PostgreSQL integration-test URLs. Tests skip when the primary test
# URL is unset; do not put a shared or production database URL here.
ZENDO_TEST_DATABASE_URL=
ZENDO_TEST_DATABASE_REPLICA_URL=

# Optional PostgreSQL read replica. Reads use it when it differs from the primary.
ZENDO_DATABASE_REPLICA_URL=

# Pool size per process. Put PgBouncer in transaction mode in front of many processes
# and keep this small (4 to 10) so the database does not see one connection per request.
ZENDO_PG_POOL_MAX=20
ZENDO_PG_IDLE_MS=10000
ZENDO_PG_CONNECT_MS=5000
ZENDO_PG_STATEMENT_MS=8000

# Valkey or Redis. Same protocol. Prices, the launchpad book, and shared sign-in attempt counts.
# Leave unset and this process keeps that cache in memory.
ZENDO_REDIS_URL=

# Same value on every app instance so a signed cookie works behind a load balancer.
# At least 32 characters. Leave unset and this process keeps data/jwt.secret mode 0600.
ZENDO_JWT_SECRET=

# Comma-separated primary URL per shard index, used when ZENDO_DATABASE_URL is unset.
ZENDO_SHARD_DATABASE_URLS=

# gRPC listens only when this port is set. proto/zendo.proto is the contract.
ZENDO_GRPC_PORT=

# Live WebSocket listens only when this port is set. SSE stays on GET /api/stream.
ZENDO_WS_PORT=

# Open streams on this process. Default is 20000. More clients means more gateway processes.
ZENDO_CONNECTION_CAP=

# The public https origin. Phone links and secure cookies should use this host.
# Cross-origin API calls are allowed only for this origin. A wildcard is ignored.
ZENDO_PUBLIC_ORIGIN=

# Unused for CORS. Kept so older host notes still parse. Access is ZENDO_PUBLIC_ORIGIN only.
ZENDO_CORS_ORIGIN=

# Rust validator RPC, for example http://127.0.0.1:47111. Checked by host-check.
ZENDO_L1_RPC=

# Set both before the first boot of a public ledger, then start from an empty data directory.
# ZENDO_OPERATOR_PIN is 4 digits.
ZENDO_OPERATOR_PASSWORD=
ZENDO_OPERATOR_PIN=

# Set to 1 behind HTTPS so the session cookie is Secure.
ZENDO_SECURE_COOKIES=

# Optional Polygon chain id for the external token bridge. Launchpad trades do not use it.
ZENDO_POLYGON_CHAIN_ID=137

# A TigerBeetle cluster is not started by this app. Set this only on a host that is already running TigerBeetle.
TIGERBEETLE_ADDRESSES=

# Same secret on the primary and every regional replica.
ZENDO_FLEET_SECRET=
ZENDO_PRIMARY_URL=

# Shard fleet. Leave unset for the single ledger.
ZENDO_ROLE=
ZENDO_SHARD_SECRET=
ZENDO_SHARD_COUNT=
ZENDO_SHARD_INDEX=
ZENDO_SHARD_URLS=

# Polygon reads. Use your QuickNode https endpoint. Do not put a key in the URL userinfo.
QUICKNODE_POLYGON_RPC_URL=
POLYGON_RPC_URL=

# Bridge. The key file should be mode 0600 and must never be committed.
ZENDO_POLYGON_BRIDGE=
ZENDO_BRIDGE_PRIVATE_KEY=
ZENDO_BRIDGE_CONFIRMATIONS=12
